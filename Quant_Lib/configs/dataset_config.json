{
  "sheet_mappings": {
    "SOFR": "Histocopy_SOFR",
    "FX_Rates": "Histocopy_FX",
    "CCS_Spreads": "Histocopy_CCS"
  },
  "validation_rules": {
    "max_null_percentage": 5.0,
    "required_columns": {
      "Histocopy_SOFR": ["USDSROISONZ=R", "USDSROIS1YZ=R", "USDSROIS5YZ=R"],
      "Histocopy_FX": ["USDVND", "EURUSD", "USDJPY"],
      "Histocopy_CCS": ["USDVND/CCS/LIBOR3M-F/1Y-SOFR", "USDVND/CCS/LIBOR3M-F/5Y-SOFR"]
    }
  },
  "export_settings": {
    "date_format": "%Y-%m-%d",
    "decimal_places": 6,
    "include_metadata": true
  },
  "update_frequency": "daily",
  "retention_days": 365,
  "backup_enabled": true
}